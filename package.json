{
  "name": "linkr",
  "version": "0.1.0",
  "private": true,
  "description": "Linkr: organise your ideas. Self-hosted links and notes, synced across your devices.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "lint": "npm run lint -w web",
    "db:generate": "npm run db:generate -w server"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
