# Copy this file to .env and adjust. Every setting is optional.

# The address people use to open Linkr, e.g. your Cloudflare Tunnel hostname.
# Sign-in cookies and request checks are tied to it.
BASE_URL=http://localhost:8080

# Port and network interface to listen on. 127.0.0.1 keeps Linkr private to this
# computer (a tunnel reaches it locally); use 0.0.0.0 to open it to your LAN.
PORT=8080
HOST=127.0.0.1

# Other addresses Linkr is opened from (comma separated), e.g. http://192.168.1.20:8080
TRUSTED_ORIGINS=

# open: anyone who can reach the server can create an account.
# closed: only the first account (the owner) can be created.
REGISTRATION=open

# Where the database, cached images and generated auth secret are stored.
DATA_DIR=data

# Session signing secret. Generated into DATA_DIR on first run if left empty.
AUTH_SECRET=
