{
  "id": "/",
  "name": "Linkr",
  "short_name": "Linkr",
  "description": "Linkr: organise your ideas. Links and notes, synced across your devices.",
  "start_url": "./?launcher=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#FF9500",
